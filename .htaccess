# جلوگیری از دسترسی مستقیم به فایل‌های حساس پروژه

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|data|tools|cron|storage)(/|$) - [F,L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|db|log|env|ini|bak|key|pem)$">
    Require all denied
</FilesMatch>

# فقط entrypointهای وب عمومی
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>
<FilesMatch "^(composer\.(json|lock)|README\.md)$">
    Require all denied
</FilesMatch>

# خروجی ابزار پیش‌نمایش مینی‌اپ.
# ⚠️ اگر این فایل روی سرور باشد، `initData` معتبر داخلش هست و یعنی هر کسی
# می‌تواند خود را جای هر کاربری جا بزند. باید از دسترس وب خارج بماند.
<Files "_preview.html">
    Require all denied
</Files>